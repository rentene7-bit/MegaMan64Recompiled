<template name="config-menu__general">
    <head>
    </head>
    <body>
        <form class="config__form" id="conf-general__form">
            <div class="config__hz-wrapper" id="conf-general__hz-wrapper">
                <!-- Options -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" id="conf-general__wrapper">
                    <!-- rumble strength -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">Rumble Strength</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{rumble_strength}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(1)"
                                id="rumble_strength_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp;"
                                data-value="rumble_strength"
                            />
                        </div>
                    </div>
                    
                    <!-- joystick deadzone -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(4)">
                        <label class="config-option__title">Joystick Deadzone</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{joystick_deadzone}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(4)"
                                id="joystick_deadzone_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp; nav-down: #bg_input_enabled"
                                data-value="joystick_deadzone"
                            />
                        </div>
                    </div>

                    <!-- background input -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(5)" id="conf-general__Background-Input">
                        <label class="config-option__title">Background Input</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(5)"
                                name="background_input_mode"
                                data-checked="background_input_mode"
                                value="On"
                                id="bg_input_enabled"
                                style="nav-up: #joystick_deadzone_input; nav-down: #film_grain_mode_on"
                            />
                            <label class="config-option__tab-label" for="bg_input_enabled">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(5)"
                                name="background_input_mode"
                                data-checked="background_input_mode"
                                value="Off"
                                id="bg_input_disabled"
                                style="nav-up: #joystick_deadzone_input; nav-down: #film_grain_mode_off"
                            />
                            <label class="config-option__tab-label" for="bg_input_disabled">Off</label>
                        </div>
                    </div>

                    <!-- Invert Y Axis -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(7)">
                        <label class="config-option__title">Invert Y Axis</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(7)"
                                name="invert_y_axis_mode"
                                data-checked="invert_y_axis_mode"
                                value="On"
                                id="invert_y_axis_mode_on"
                                style="nav-up: #film_grain_mode_on;"
                            />
                            <label class="config-option__tab-label" for="invert_y_axis_mode_on">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(7)"
                                name="invert_y_axis_mode"
                                data-checked="invert_y_axis_mode"
                                value="Off"
                                id="invert_y_axis_mode_off"
                                style="nav-up: #film_grain_mode_off;"
                            />
                            <label class="config-option__tab-label" for="invert_y_axis_mode_off">Off</label>
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(10)">
                        <label class="config-option__title">PS1 disc</label>
                        <div class="config-option__list">
                            <button class="nav-vert" id="remaster_disc_button" onclick="select_ps1_disc">Select disc image</button>
                        </div>
                        <label>{{remaster_disc_status}}</label>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(11)">
                        <label class="config-option__title">Draw distance</label>
                        <div class="config-option__list">
                            <input type="radio" class="nav-vert" name="remaster_draw_distance" data-checked="remaster_draw_distance" value="Off" id="remaster_draw_off"/>
                            <label class="config-option__tab-label" for="remaster_draw_off">Off</label>
                            <input type="radio" class="nav-vert" name="remaster_draw_distance" data-checked="remaster_draw_distance" value="Low" id="remaster_draw_low"/>
                            <label class="config-option__tab-label" for="remaster_draw_low">Low</label>
                            <input type="radio" class="nav-vert" name="remaster_draw_distance" data-checked="remaster_draw_distance" value="Medium" id="remaster_draw_medium"/>
                            <label class="config-option__tab-label" for="remaster_draw_medium">Medium</label>
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(12)">
                        <label class="config-option__title">Texture pack budget</label>
                        <div class="config-option__list">
                            <input type="radio" class="nav-vert" name="remaster_texture_budget" data-checked="remaster_texture_budget" value="256 MB" id="remaster_budget_256"/>
                            <label class="config-option__tab-label" for="remaster_budget_256">256 MB</label>
                            <input type="radio" class="nav-vert" name="remaster_texture_budget" data-checked="remaster_texture_budget" value="512 MB" id="remaster_budget_512"/>
                            <label class="config-option__tab-label" for="remaster_budget_512">512 MB</label>
                            <input type="radio" class="nav-vert" name="remaster_texture_budget" data-checked="remaster_texture_budget" value="1 GB" id="remaster_budget_1024"/>
                            <label class="config-option__tab-label" for="remaster_budget_1024">1 GB</label>
                            <input type="radio" class="nav-vert" name="remaster_texture_budget" data-checked="remaster_texture_budget" value="Unlimited" id="remaster_budget_unlimited"/>
                            <label class="config-option__tab-label" for="remaster_budget_unlimited">Unlimited</label>
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(13)">
                        <label class="config-option__title">PS1 music</label>
                        <div class="config-option__list">
                            <input type="radio" class="nav-vert" name="remaster_ps1_music" data-checked="remaster_ps1_music" value="Off" id="remaster_music_off"/>
                            <label class="config-option__tab-label" for="remaster_music_off">Off</label>
                            <input type="radio" class="nav-vert" name="remaster_ps1_music" data-checked="remaster_ps1_music" value="On" id="remaster_music_on"/>
                            <label class="config-option__tab-label" for="remaster_music_on">On</label>
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(14)">
                        <label class="config-option__title">Cutscene skip</label>
                        <div class="config-option__list">
                            <input type="radio" class="nav-vert" name="remaster_cutscene_skip" data-checked="remaster_cutscene_skip" value="Off" id="remaster_skip_off"/>
                            <label class="config-option__tab-label" for="remaster_skip_off">Off</label>
                            <input type="radio" class="nav-vert" name="remaster_cutscene_skip" data-checked="remaster_cutscene_skip" value="On" id="remaster_skip_on"/>
                            <label class="config-option__tab-label" for="remaster_skip_on">On</label>
                        </div>
                    </div>

                </div>

                <!-- Descriptions -->
                <div class="config__wrapper">
                    <p data-if="cur_config_index == 0">
                        Controls how targeting enemies and objects works. <b>Switch</b> will start or stop targeting each time the target button is pressed. <b>Hold</b> will start when the target button is pressed and stop when the button is released. 
                    </p>
                    <p data-if="cur_config_index == 1">
                        Controls the strength of rumble when using a controller that supports it. <b>Setting this to zero will disable rumble.</b>
                    </p>
                    <p data-if="cur_config_index == 2">
                        Controls the sensitivity of gyro aiming when using items in first person for controllers that support it. <b>Setting this to zero will disable gyro.</b>
                        <br />
                        <br />
                        <b>Note: To recalibrate controller gyro, set the controller down on a still, flat surface for 5 seconds.</b>
                    </p>
                    <p data-if="cur_config_index == 3">
                        Controls the sensitivity of mouse aiming when using items in first person. <b>Setting this to zero will disable mouse aiming.</b>
                        <br />
                        <br />
                        <b>Note: This option does not allow mouse buttons to activate items. Mouse aiming is intended to be used with inputs that are mapped to mouse movement, such as gyro on Steam Deck.</b>
                    </p>
                    <p data-if="cur_config_index == 4">
                        Applies a deadzone to joystick inputs.
                    </p>
                    <p data-if="cur_config_index == 5">
                        Allows the game to read controller input when out of focus.
                        <br/>
                        <b>This setting does not affect keyboard input.</b>
                    </p>
                    <p data-if="cur_config_index == 6">
                        Adds a visual effect that simulates the random grain you see in old film or high-ISO camera footage.
                        <br/>
                    </p>
                    <p data-if="cur_config_index == 7">
                        Inverts the Y axis aiming controls. <b>On</b> is the default and matches the original game.
                    </p>
                    <p data-if="cur_config_index == 8">
                        Alignment for Radio Communications Box.
                        <br/>
                    </p>
                    <p data-if="cur_config_index == 9">
                        Inverts the camera controls for the analog camera if it's enabled. <b>None</b> is the default.
                    </p>
                    <p data-if="cur_config_index == 10">
                        Your own Mega Man Legends or Rockman DASH disc image: BIN/CUE, ISO, or uncompressed CHD. The language comes from that disc. Nothing from the disc is stored with the game. If this is empty or cannot be read, voices and music stay on the N64 soundtrack.
                    </p>
                    <p data-if="cur_config_index == 11">
                        Experimental. <b>Off</b> is the default and the right choice on a weak GPU or a shared-memory machine. <b>Low</b> and <b>Medium</b> only push the fog, and they never grow render buffers. Actor pop-in is unchanged. Turn it off if the frame rate drops.
                    </p>
                    <p data-if="cur_config_index == 12">
                        Caps how much HD texture data is loaded from the texture_packs folder. <b>512 MB</b> is the default on every PC, including a handheld with shared graphics memory. Lower it when RAM is tight. This does not raise the internal resolution.
                    </p>
                    <p data-if="cur_config_index == 13">
                        Experimental and off by default. CD audio and sequenced files on the disc are recognized, but the game's music call is not hooked up yet, so the N64 soundtrack still plays.
                    </p>
                    <p data-if="cur_config_index == 14">
                        Experimental and off by default. Backspace, or the controller Back button, asks the current fade to finish during a cutscene. It does not yet advance the cutscene itself.
                    </p>
                </div>
            </div>
        </form>
    </body>
</template>
